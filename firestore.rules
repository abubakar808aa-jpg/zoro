rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    match /users/{uid} {
      allow read: if true;
      // Users manage their own doc but can never grant themselves admin or
      // touch ban state — those fields are written only by the server
      // (Admin SDK in /api/admin, which bypasses these rules).
      allow create: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['isAdmin', 'banned', 'bannedReason']);
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['isAdmin', 'banned', 'bannedReason']);
    }
    match /profiles/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /jobs/{id} {
      allow read: if true;
      // Browser clients may create only their own manually posted jobs, and may
      // not forge boost or import fields (those are set server-side via the
      // Admin SDK: boosts by the Stripe webhook, imports by the ingestion route).
      allow create: if request.auth != null
        && request.resource.data.postedBy == request.auth.uid
        && !request.resource.data.keys().hasAny(['boosted', 'boostedUntil', 'isImported']);
      // Imported jobs are read-only to clients. For a manually posted job the
      // owner may edit anything except the server-managed fields, OR any signed-in
      // user may bump applicantCount by exactly 1 (applyToJob does this).
      allow update: if request.auth != null
        && !resource.data.keys().hasAny(['isImported'])
        && (
          (request.auth.uid == resource.data.postedBy
            && request.resource.data.postedBy == resource.data.postedBy
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['boosted', 'boostedUntil', 'isImported']))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applicantCount'])
              && request.resource.data.applicantCount == resource.data.applicantCount + 1)
        );
      allow delete: if request.auth != null && request.auth.uid == resource.data.postedBy;
    }
    match /jobSources/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /applications/{id} {
      allow create: if request.auth != null
        && request.resource.data.applicantId == request.auth.uid
        && request.resource.data.status == 'pending';
      // Only the applicant and the job's poster may see an application.
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.applicantId
            || request.auth.uid == resource.data.jobPostedBy);
      // Only the job's poster may change it, and only the status field.
      allow update: if request.auth != null
        && request.auth.uid == resource.data.jobPostedBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }
    match /conversations/{id} {
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants;
      allow read, update: if request.auth != null
        && request.auth.uid in resource.data.participants;
      match /messages/{msgId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(id)).data.participants;
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(id)).data.participants;
      }
    }
    match /follows/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.followerId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.followerId == request.auth.uid;
    }
    match /activities/{id} {
      allow read: if request.auth != null;
      // You can only publish activity as yourself.
      allow create: if request.auth != null
        && request.resource.data.actorId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.actorId == request.auth.uid;
    }
    match /reports/{id} {
      allow create: if request.auth != null
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.resolved == false;
      // Only staff can browse reports; resolution happens server-side.
      allow read: if isAdmin();
    }
    // Raw provider payloads — server-only/debug-only. Never exposed to clients;
    // the ingestion route writes these through the Admin SDK, which bypasses rules.
    match /jobRaw/{id} {
      allow read, write: if false;
    }
    // Ingestion telemetry — staff-readable, written only server-side.
    match /ingestionRuns/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /sourceFetchLogs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // A user's saved/bookmarked jobs — private to the owner. Doc id is
    // `${uid}_${jobId}` and the doc carries uid.
    match /savedJobs/{id} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.jobId is string;
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }
  }
}
