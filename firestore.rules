rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    match /users/{uid} {
      allow read: if true;
      // Users manage their own doc but can never grant themselves admin or
      // touch ban state — those fields are written only by the server
      // (Admin SDK in /api/admin, which bypasses these rules).
      allow create: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['isAdmin', 'banned', 'bannedReason']);
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['isAdmin', 'banned', 'bannedReason']);
    }
    match /profiles/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /jobs/{id} {
      allow read: if true;
      // Browser clients may create only their own manually posted jobs, and may
      // not forge boost or import fields (those are set server-side via the
      // Admin SDK: boosts by the Stripe webhook, imports by the ingestion route).
      allow create: if request.auth != null
        && request.resource.data.postedBy == request.auth.uid
        && !request.resource.data.keys().hasAny(['boosted', 'boostedUntil', 'isImported']);
      // Imported jobs are read-only to clients. For a manually posted job the
      // owner may edit anything except the server-managed fields, OR any signed-in
      // user may bump applicantCount by exactly 1 (applyToJob does this).
      allow update: if request.auth != null
        && !resource.data.keys().hasAny(['isImported'])
        && (
          (request.auth.uid == resource.data.postedBy
            && request.resource.data.postedBy == resource.data.postedBy
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['boosted', 'boostedUntil', 'isImported']))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applicantCount'])
              && request.resource.data.applicantCount == resource.data.applicantCount + 1)
        );
      allow delete: if request.auth != null && request.auth.uid == resource.data.postedBy;
    }
    match /jobSources/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /applications/{id} {
      allow create: if request.auth != null
        && request.resource.data.applicantId == request.auth.uid
        && request.resource.data.status == 'pending';
      // Only the applicant and the job's poster may see an application.
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.applicantId
            || request.auth.uid == resource.data.jobPostedBy);
      // Only the job's poster may change it, and only the status field.
      allow update: if request.auth != null
        && request.auth.uid == resource.data.jobPostedBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }
    match /serviceRequests/{id} {
      // The first slice stores only the service area, never a street address.
      // Matching, booking, cancellation, and payment changes remain server-only.
      allow create: if request.auth != null
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.keys().hasAll([
          'customerId', 'customerName', 'category', 'description', 'city',
          'preferredDate', 'timeWindow', 'budgetMin', 'budgetMax', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'customerId', 'customerName', 'category', 'description', 'city',
          'preferredDate', 'timeWindow', 'estimatedDurationMinutes', 'currency',
          'budgetMin', 'budgetMax', 'status', 'createdAt'
        ])
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() <= 120
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.category.size() <= 64
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 2000
        && request.resource.data.city is string
        && request.resource.data.city.size() >= 2
        && request.resource.data.city.size() <= 120
        && request.resource.data.preferredDate is string
        && request.resource.data.preferredDate.size() <= 10
        && request.resource.data.timeWindow in ['morning', 'afternoon', 'evening', 'flexible']
        && (!('estimatedDurationMinutes' in request.resource.data)
            || (request.resource.data.estimatedDurationMinutes is int
                && request.resource.data.estimatedDurationMinutes >= 30
                && request.resource.data.estimatedDurationMinutes <= 720))
        && (!('currency' in request.resource.data) || request.resource.data.currency == 'USD')
        && (request.resource.data.budgetMin == null
            || (request.resource.data.budgetMin is number && request.resource.data.budgetMin >= 0))
        && (request.resource.data.budgetMax == null
            || (request.resource.data.budgetMax is number && request.resource.data.budgetMax >= 0))
        && (request.resource.data.budgetMin == null
            || request.resource.data.budgetMax == null
            || request.resource.data.budgetMax >= request.resource.data.budgetMin)
        && request.resource.data.createdAt is timestamp;
      // Professionals receive only the server API's redacted allowlist. Even an
      // assigned professional cannot read the full customer request document.
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.customerId || isAdmin());
      allow update, delete: if false;
    }
    match /workerGigPreferences/{uid} {
      // A worker's earnings floor is matching input, not public profile data.
      allow read: if request.auth != null
        && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.workerId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'workerId', 'serviceArea', 'serviceRadiusMiles',
          'minimumHourlyTakeHome', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'workerId', 'serviceArea', 'serviceRadiusMiles',
          'minimumHourlyTakeHome', 'updatedAt'
        ])
        && request.resource.data.serviceArea is string
        && request.resource.data.serviceArea.size() >= 2
        && request.resource.data.serviceArea.size() <= 120
        && request.resource.data.serviceRadiusMiles is number
        && request.resource.data.serviceRadiusMiles >= 1
        && request.resource.data.serviceRadiusMiles <= 100
        && request.resource.data.minimumHourlyTakeHome is number
        && request.resource.data.minimumHourlyTakeHome >= 1
        && request.resource.data.minimumHourlyTakeHome <= 1000
        && request.resource.data.updatedAt is timestamp;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /opportunityResponses/{id} {
      // Responses are created and read only by authenticated server routes.
      // This prevents customer and cross-professional access even if a browser
      // guesses the deterministic response document ID.
      allow read, write: if false;
    }
    match /marketplaceEvents/{id} {
      // Privacy-safe operational telemetry is server-only.
      allow read, write: if false;
    }
    match /conversations/{id} {
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants;
      allow read, update: if request.auth != null
        && request.auth.uid in resource.data.participants;
      match /messages/{msgId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(id)).data.participants;
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(id)).data.participants;
      }
    }
    match /follows/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.followerId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.followerId == request.auth.uid;
    }
    match /activities/{id} {
      allow read: if request.auth != null;
      // You can only publish activity as yourself.
      allow create: if request.auth != null
        && request.resource.data.actorId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.actorId == request.auth.uid;
    }
    match /reports/{id} {
      allow create: if request.auth != null
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.resolved == false;
      // Only staff can browse reports; resolution happens server-side.
      allow read: if isAdmin();
    }
  }
}
