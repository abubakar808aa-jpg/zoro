# Copy to `.env` (apps/mobile/.env) for local dev. Expo inlines any variable
# prefixed EXPO_PUBLIC_ into the app bundle at build time. These are the same
# Firebase web-app values used by the website — get them from Firebase Console
# → Project Settings → Your apps → Web app.
#
# The apiKey is a public project identifier, not a secret (access is controlled
# by Firestore/Storage security rules), but it still belongs in .env, not source.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google OAuth Web Client ID (for Google sign-in on mobile).
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# → the "Web application" client. Email sign-in works without this.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
