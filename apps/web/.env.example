# Copy to .env.local for local dev. On Vercel, set these in Project Settings → Environment Variables.

# Required — server-side only, never exposed to the browser.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Free local AI fallback for the admin agent dashboard.
# Install Ollama, then run: ollama pull llama3.2:3b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Optional — Claude model for AI features (default: claude-haiku-4-5)
# AI_MODEL=claude-haiku-4-5

# Payments (boosted listings) — from https://dashboard.stripe.com/apikeys
# Webhook secret comes from Dashboard → Developers → Webhooks → your endpoint
# (endpoint URL: https://<your-domain>/api/stripe/webhook, event: checkout.session.completed)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# LinkedIn profile import ("Sign In with LinkedIn using OpenID Connect" product
# at https://linkedin.com/developers — add <your-domain>/api/linkedin/callback
# as an authorized redirect URL). Free tier imports name/email/photo only.
# NEXT_PUBLIC_LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# Server-side Firebase writes via the Admin SDK — used by the Stripe webhook,
# /api/admin actions, and all job-board ingestion endpoints (/api/ingest/*).
# Firebase Console → Project Settings → Service accounts → Generate new private
# key, then paste the whole JSON on ONE line:
FIREBASE_SERVICE_ACCOUNT_KEY=

# Job-board ingestion — a long random value protecting POST /api/ingest/*.
# Call those endpoints with: Authorization: Bearer <this value>. Server-side only.
INGESTION_SECRET=

# Scheduled connector refresh — Vercel sends this automatically as a Bearer
# token when it calls /api/cron/ingest. Generate a long random value.
CRON_SECRET=

# Optional JSON array of ATS sources. Every public connector uses sourceKey as
# the employer board/company identifier; no ATS credential is required.
CONNECTOR_SOURCES_JSON=[]

# Set false to disable the included Figma, Palantir, Ramp, SmartRecruiters,
# Common App, Resourceful Talent Group, Remotive, and Arbeitnow starters.
ENABLE_STARTER_SOURCES=true

# Optional JSON: [{"name":"Publisher","url":"https://example.com/feed.xml"}]
# Replaces the built-in RSS list when it contains at least one valid entry.
NEWS_RSS_FEEDS=[]

# Optional JSON: HTML pages to scrape for publishers with no RSS/Atom feed.
# Added on top of the RSS sources above. Structured JSON-LD article metadata is
# used when present; otherwise supply linkPattern (a regex matched against each
# link's href) so only real article links are picked up.
# [{"name":"Publisher","url":"https://example.com/news","linkPattern":"/20\\d{2}/"}]
NEWS_HTML_SOURCES=[]

# Required — Firebase web app config. From Firebase Console → Project Settings →
# Your apps → Web app → the `firebaseConfig` object. These are exposed to the
# browser (the apiKey is a public project identifier, not a secret — access is
# controlled by Firestore/Storage security rules). The app will not connect to
# Firebase without them.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
